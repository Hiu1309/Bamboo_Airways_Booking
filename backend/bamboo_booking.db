-- Bamboo Airways Booking database for XAMPP MySQL/MariaDB.
-- Import this file in phpMyAdmin, or run it in the SQL tab.

CREATE DATABASE IF NOT EXISTS bamboo_booking
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

USE bamboo_booking;

CREATE TABLE IF NOT EXISTS users (
    id VARCHAR(255) NOT NULL,
    username VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    full_name VARCHAR(255),
    identity_number VARCHAR(255),
    phone VARCHAR(255),
    gender VARCHAR(255),
    member_number VARCHAR(255),
    role VARCHAR(255),
    date_of_birth DATETIME(6),
    created_at DATETIME(6),
    updated_at DATETIME(6),
    PRIMARY KEY (id),
    UNIQUE KEY uk_users_username (username),
    UNIQUE KEY uk_users_email (email),
    KEY idx_users_email (email),
    KEY idx_users_username (username)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS aircraft_entity (
    id VARCHAR(255) NOT NULL,
    code VARCHAR(255),
    model VARCHAR(255),
    seat_layout VARCHAR(255),
    seat_rows INT NOT NULL,
    PRIMARY KEY (id),
    UNIQUE KEY uk_aircraft_code (code)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS airport_entity (
    id VARCHAR(255) NOT NULL,
    code VARCHAR(255),
    name VARCHAR(255),
    city VARCHAR(255),
    country VARCHAR(255),
    PRIMARY KEY (id),
    UNIQUE KEY uk_airport_code (code)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS flight_entity (
    id VARCHAR(255) NOT NULL,
    flight_number VARCHAR(255),
    departure_airport_id VARCHAR(255),
    arrival_airport_id VARCHAR(255),
    aircraft_id VARCHAR(255),
    departure_at DATETIME(6),
    arrival_at DATETIME(6),
    base_price INT NOT NULL,
    business_price INT NOT NULL,
    status VARCHAR(255),
    PRIMARY KEY (id),
    UNIQUE KEY uk_flight_number (flight_number),
    KEY idx_flight_route_time (
        departure_airport_id,
        arrival_airport_id,
        departure_at
    )
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS fare_entity (
    id VARCHAR(255) NOT NULL,
    flight_id VARCHAR(255),
    cabin_class VARCHAR(255),
    fare_name VARCHAR(255),
    price INT NOT NULL,
    baggage_kg INT NOT NULL,
    available_seats INT NOT NULL,
    refundable TINYINT(1) NOT NULL,
    changeable TINYINT(1) NOT NULL,
    PRIMARY KEY (id)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS booking_entity (
    id VARCHAR(255) NOT NULL,
    booking_code VARCHAR(255),
    user_id VARCHAR(255),
    flight_id VARCHAR(255),
    cabin_class VARCHAR(255),
    fare_name VARCHAR(255),
    contact_email VARCHAR(255),
    contact_phone VARCHAR(255),
    status VARCHAR(255),
    subtotal INT NOT NULL,
    tax INT NOT NULL,
    seat_fee INT NOT NULL,
    total INT NOT NULL,
    expires_at DATETIME(6),
    created_at DATETIME(6),
    updated_at DATETIME(6),
    PRIMARY KEY (id),
    UNIQUE KEY uk_booking_code (booking_code)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS seat_entity (
    id VARCHAR(255) NOT NULL,
    flight_id VARCHAR(255),
    code VARCHAR(255),
    cabin_class VARCHAR(255),
    status VARCHAR(255),
    price INT NOT NULL,
    booking_id VARCHAR(255),
    PRIMARY KEY (id),
    KEY idx_seat_flight_status (flight_id, status)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS passenger_entity (
    id VARCHAR(255) NOT NULL,
    booking_id VARCHAR(255),
    title VARCHAR(255),
    first_name VARCHAR(255),
    last_name VARCHAR(255),
    identity_number VARCHAR(255),
    member_number VARCHAR(255),
    date_of_birth DATETIME(6),
    PRIMARY KEY (id)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS payment_entity (
    id VARCHAR(255) NOT NULL,
    booking_id VARCHAR(255),
    method VARCHAR(255),
    provider_ref VARCHAR(255),
    amount INT NOT NULL,
    status VARCHAR(255),
    paid_at DATETIME(6),
    created_at DATETIME(6),
    PRIMARY KEY (id)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS review_entity (
    id VARCHAR(255) NOT NULL,
    user_id VARCHAR(255),
    comment VARCHAR(255),
    rating INT NOT NULL,
    approved TINYINT(1) NOT NULL,
    created_at DATETIME(6),
    PRIMARY KEY (id)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS loyalty_entry_entity (
    id VARCHAR(255) NOT NULL,
    transaction_no VARCHAR(255),
    user_id VARCHAR(255),
    description VARCHAR(255),
    type VARCHAR(255),
    points INT NOT NULL,
    created_at DATETIME(6),
    PRIMARY KEY (id),
    UNIQUE KEY uk_loyalty_transaction_no (transaction_no)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS refresh_token_entity (
    id VARCHAR(255) NOT NULL,
    token_hash VARCHAR(255),
    user_id VARCHAR(255),
    expires_at DATETIME(6),
    revoked_at DATETIME(6),
    created_at DATETIME(6),
    PRIMARY KEY (id),
    UNIQUE KEY uk_refresh_token_hash (token_hash)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS password_reset_token_entity (
    id VARCHAR(255) NOT NULL,
    token_hash VARCHAR(255),
    user_id VARCHAR(255),
    expires_at DATETIME(6),
    used_at DATETIME(6),
    created_at DATETIME(6),
    PRIMARY KEY (id),
    UNIQUE KEY uk_password_reset_token_hash (token_hash)
) ENGINE=InnoDB;
